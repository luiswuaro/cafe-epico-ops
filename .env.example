# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# App
APP_ORIGIN=http://localhost:3000
DEFAULT_ORGANIZATION_SLUG=cafe-epico
DEFAULT_STORE_CODE=TEPEXI

# Loyverse - server only. Never expose these as NEXT_PUBLIC_*.
LOYVERSE_ACCESS_TOKEN=replace-me
LOYVERSE_WEBHOOK_CLIENT_SECRET=
# Required for unsigned PAT-created webhooks: append ?token=<value> to webhook URL.
LOYVERSE_WEBHOOK_INGEST_TOKEN=replace-with-long-random-value
LOYVERSE_MERCHANT_ID=

# Optional scheduler/internal endpoint guard
CRON_SECRET=replace-with-long-random-value
