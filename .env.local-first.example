# EJEMPLO DE PILOTO AISLADO: NO poner credenciales reales en GitHub.
# Copiar SOLO en la PC a .env.local, configurar tras instalar Supabase self-host.
# NUNCA copiar URLs/contraseñas de Supabase producción a este archivo.
OPS_LOCAL_FIRST=true
OPS_QA_MODE=true
POS_LIVE_ENABLED=false
DEFAULT_ORGANIZATION_SLUG=cafe-epico-qa
DEFAULT_STORE_CODE=QA-TEPEXI

# PostgreSQL local solamente, no Vercel y no la nube:
# Ajustar POOLER_TENANT_ID conforme al .env local del self-host.
# Supavisor Session usa postgres.<POOLER_TENANT_ID> como usuario:
DATABASE_URL=postgresql://postgres.cafe-epico-qa:REEMPLAZAR@127.0.0.1:5432/postgres
# Gateway local protegido mediante un certificado HTTPS confiable:
NEXT_PUBLIC_SUPABASE_URL=https://192.168.1.100:8443
APP_ORIGIN=https://192.168.1.100:8443
# Certificado PUBLICO root.crt de la CA local Caddy (no llave privada):
OPS_LOCAL_CA_FILE=C:/RUTA-PRIVADA-DEL-EQUIPO/Caddy/root.crt
# Clave PUBLICABLE del Auth autoalojado, NUNCA la service_role en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=REEMPLAZAR

# Desactivamos entradas legacy de Loyverse y proveedores de nube:
OPS_LEGACY_LOYVERSE_AUTOSYNC=false

# SOLO PC LOCAL QA: token exclusivo de agente (>32 caracteres aleatorios).
# Crear con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# La cuenta Auth debe estar vinculada a un empleado QA activo con pos.sell.
OPS_LOCAL_PRINT_AGENT_TOKEN=REEMPLAZAR_CON_64_HEX
OPS_LOCAL_PRINT_AGENT_USER_ID=REEMPLAZAR_UUID_AUTH_QA
# El token del puente ESC/POS Windows no es el token del agente.
OPS_LOCAL_TICKET_PRINTER_TOKEN=REEMPLAZAR_TOKEN_PUENTE
# Opcional: si la impresora de barra es distinta, configurar esta variable.
OPS_LOCAL_KITCHEN_PRINTER_TOKEN=REEMPLAZAR_TOKEN_PUENTE

# Si true, las pestañas no reclaman trabajos: opera el worker de Windows QA.
NEXT_PUBLIC_OPS_LOCAL_PRINT_AGENT_ENABLED=false

# Tiempo entre tickets para POS-58 sin guillotina (0 si la impresora autocorta).
OPS_LOCAL_PRINT_GAP_SECONDS=12
